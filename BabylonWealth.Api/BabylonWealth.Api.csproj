<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>BabylonWealth.Api</AssemblyName>
    <RootNamespace>BabylonWealth.Api</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
    <Folder Include="Middleware\" />
    <Folder Include="BackgroundServices\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BabylonWealth.Core\BabylonWealth.Core.csproj" />
    <ProjectReference Include="..\BabylonWealth.Infrastructure\BabylonWealth.Infrastructure.csproj" />
    <ProjectReference Include="..\BabylonWealth.Services\BabylonWealth.Services.csproj" />
  </ItemGroup>

</Project>
